# 首次使用复制为 .env；已有配置直接编辑，修改后重启任务或服务。
# 完整参数说明：README.md、naruto_daily/login_service/README.md

# 模型：至少填写一个渠道的 key，模型名按渠道独立配置；只读取根目录 .env。
YUWAN_API_KEY=
YUWAN_MODEL=deepseek-v4.1-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Redis：模型路由与扫码服务共用，按实际地址填写。
# 带密码格式：redis://:your-password@host:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# OSS：扫码服务必填，与客户端使用相同地域和 Bucket。
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 雷电扫码：默认 mock；真实登录时取消注释并修改路径、实例索引。
# EMULATOR_DRIVER=ldplayer
# LDPLAYER_CONSOLE_PATH=C:\LDPlayer\LDPlayer9\dnconsole.exe
# LDPLAYER_POOL_INDICES=0,2
# WORKER_CONCURRENCY=2
# DAILY_CONFIG_PATH=config.example.json

# 账号：直接登录使用的完整昵称，扫码登录可留空。
LOGIN_ACCOUNT_NAME=
