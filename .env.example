# 首次使用复制为 .env；已有配置直接编辑，修改后重启任务或服务。
# 完整参数说明：README.md、docs/test-jev-client-protocol.md

# 两个 Cloudflare KV namespace：prod 使用 hyrz，test 使用 hyrz-test。
# JEV 测试工作区显式使用 test；省略 APP_ENV 时程序默认 prod。
APP_ENV=test
# Token 需要目标账户的 Workers KV Storage Read 权限。
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID_PROD=
CLOUDFLARE_KV_NAMESPACE_ID_TEST=
# prod 兼容旧 CLOUDFLARE_KV_NAMESPACE_ID；test 不允许使用旧 ID 回退。
# 业务配置全部存放 KV：Redis、OSS、数据库、模型、QQ、计数器、状态目录。
# 每个 namespace 使用相同普通变量名，例如 REDIS_QUEUE_KEY、OSS_KEY_PREFIX、JEV_API_KEY。
# 不在这里重复填写 REDIS_* / OSS_* / DATABASE_URL 等业务值。

# 雷电扫码默认 mock；真实登录时修改驱动并填写测试专用实例索引。
EMULATOR_DRIVER=mock
# LDPLAYER_CONSOLE_PATH=C:\LDPlayer\LDPlayer9\dnconsole.exe
# LDPLAYER_POOL_INDICES=0,2
# WORKER_CONCURRENCY=2
# DAILY_CONFIG_PATH=config.example.json
# LDPLAYER_STATE_DIR 由选定 Cloudflare namespace 配置，不在本机覆盖。

# 账号：直接登录使用的完整昵称，扫码登录可留空。
LOGIN_ACCOUNT_NAME=
