# 首次配置时复制为项目根目录的 .env；已有 .env 时直接编辑。
# 普通任务、扫码服务和实例池管理默认共用这一份配置。
# 以下三项模型配置固定从项目根目录 .env 读取，不接受进程环境或 --env-file 的同名覆盖。
# 其他变量允许进程环境覆盖；修改后重启正在运行的任务或扫码服务。
MULTIMODAL_API_KEY=
MULTIMODAL_BASE_URL=https://llm-proxy.yuwan-game.com/v1
MULTIMODAL_MODEL=deepseek-v4.1-flash
# 直接登录使用的完整账号昵称；扫码登录不需要填写。
LOGIN_ACCOUNT_NAME=

# 扫码服务：REDIS_URL 必填，常驻 worker 不开放 HTTP 端口。
# 替换为自己的 Redis 地址和凭据；数据库由 URL 决定，默认 DB 0。
REDIS_URL=redis://127.0.0.1:6379/0
# 带密码示例：redis://:your-password@redis.example.com:6379/0
# REDIS_QUEUE_KEY=naruto:login:tasks
# WORKER_CONCURRENCY=2

# 真实雷电登录：固定使用现有实例 0 和 2，不复制新实例。
# EMULATOR_DRIVER=ldplayer
# LDPLAYER_CONSOLE_PATH=C:\LDPlayer\LDPlayer9\dnconsole.exe
# LDPLAYER_POOL_INDICES=0,2
# 兼容旧复制模式时留空 POOL，并配置模板：
# LDPLAYER_TEMPLATE=clean-login-template
# LDPLAYER_STATE_DIR=.data/login-service/ldplayer
# LDPLAYER_PACKAGE=com.tencent.KiHan
# LDPLAYER_COMMAND_TIMEOUT_SECONDS=20

# 扫码登录后，在同一子进程/模拟器中复用原完整日常任务。
# JSON 及其引用的 assets/ 必须可用；相对路径以项目根目录解析。
# DAILY_CONFIG_PATH=config.example.json
# 确认扫码授权后开始计时，登录收尾与日常任务共享预算，独立于二维码会话 TTL。
# 默认最多35分钟；允许缩短，旧配置超过2100秒也按2100秒执行。
# DAILY_TIMEOUT_SECONDS=2100
# 每个任务的 Redis 执行记录与日志：结束后保留 24 小时、最近 2000 条。
# RUN_LOG_RETENTION_SECONDS=86400
# RUN_LOG_MAX_ENTRIES=2000

# local 仅供本机验证。网站/Vercel 链路使用 oss，并填写下方配置。
STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=.data/login-service/objects

# 两边使用相同地域和 Bucket；OSS_KEY_PREFIX 默认 login，无需填写。
# OSS_REGION=oss-cn-shanghai
# OSS_BUCKET=your-private-bucket
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ACCESS_KEY_SECRET=your-access-key-secret
# OSS_STS_TOKEN=your-temporary-token
# OSS_KEY_PREFIX=login

# REDIS_URL 未设置、为空或仅包含空白时，扫码服务会提示缺少配置并以退出码 1 结束。
# 需要另一套服务参数时，可显式传入 --env-file <路径>；模型三项仍使用根目录 .env。
