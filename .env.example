# 首次使用复制为 .env；已有配置直接编辑，修改后重启任务或服务。
# 完整参数说明：README.md、naruto_daily/login_service/README.md

# Cloudflare KV：Token 需要该账户的 Workers KV Storage Read 权限。
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
# DeepSeek、Redis、OSS 配置存放在 KV，启动时读取并注入环境变量。

# 雷电扫码：默认 mock；真实登录时取消注释并修改路径、实例索引。
# EMULATOR_DRIVER=ldplayer
# LDPLAYER_CONSOLE_PATH=C:\LDPlayer\LDPlayer9\dnconsole.exe
# LDPLAYER_POOL_INDICES=0,2
# WORKER_CONCURRENCY=2
# DAILY_CONFIG_PATH=config.example.json

# 账号：直接登录使用的完整昵称，扫码登录可留空。
LOGIN_ACCOUNT_NAME=
