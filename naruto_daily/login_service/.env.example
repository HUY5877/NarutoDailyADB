# 服务专用配置，复制为本目录的 .env。客户端 TS 后端使用相同 SERVICE_TOKEN。
HOST=127.0.0.1
PORT=4320
SERVICE_TOKEN=local-development-token
STORAGE_DRIVER=local
# 默认从项目根目录解析，不依赖启动时的当前目录。
LOCAL_STORAGE_DIR=.data/login-service/objects
OSS_KEY_PREFIX=login
WORKER_CONCURRENCY=2
MAX_QUEUE_SIZE=100
MAX_TASKS=500
TASK_RETENTION_MS=60000
MOCK_STEP_DELAY_MS=600
EMULATOR_DRIVER=mock

# 可选真实 OSS；当前游戏与雷电仍为模拟。
# STORAGE_DRIVER=oss
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET=your-private-bucket
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_STS_TOKEN=
