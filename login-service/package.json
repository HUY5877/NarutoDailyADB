{
  "name": "naruto-login-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
