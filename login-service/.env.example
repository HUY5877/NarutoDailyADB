# Local-only development defaults. Use the SAME token in the client backend.
HOST=127.0.0.1
PORT=4320
SERVICE_TOKEN=local-development-token
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/objects
OSS_KEY_PREFIX=login
WORKER_CONCURRENCY=2
MAX_QUEUE_SIZE=100
MAX_TASKS=500
TASK_RETENTION_MS=60000
MOCK_STEP_DELAY_MS=600
# Only mock is implemented. ldplayer fails explicitly until an adapter exists.
EMULATOR_DRIVER=mock

# Optional real OSS adapter. Use a private Bucket and credentials on this server only.
# STORAGE_DRIVER=oss
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET=your-private-bucket
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_STS_TOKEN=
