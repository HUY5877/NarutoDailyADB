<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="huy_background">#F4F4F4</color>
    <style name="HuyTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#3568A8</item>
        <item name="android:windowBackground">@color/huy_background</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#F4F4F4</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
